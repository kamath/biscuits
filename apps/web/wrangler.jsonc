// The Worker. `vite build` generates the config wrangler actually deploys (dist/server/wrangler.json) from
// this file, and leaves a redirect to it both here and in the repository root, so `wrangler deploy` and
// `wrangler preview` work from either directory.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biscuits",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-11-01",
  // The server bundle uses AsyncLocalStorage from node:async_hooks.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Lets `wrangler preview` publish non-production branches as preview Workers. Nothing to configure yet.
  "previews": {}
}
