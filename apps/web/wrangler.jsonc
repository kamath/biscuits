// The Worker. In the Cloudflare dashboard the project's root directory is apps/web, so Workers Builds runs
// `pnpm run build` and `npx wrangler deploy` here; wrangler then finds the config the build generated.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biscuits",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-11-01",
  // The server bundle uses AsyncLocalStorage from node:async_hooks.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Lets `wrangler preview` publish non-production branches as preview Workers. Nothing to configure yet.
  "previews": {}
}
