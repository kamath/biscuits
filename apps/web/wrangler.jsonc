// The Worker. `vite build` generates the config wrangler actually deploys (dist/server/wrangler.json) from
// this file and leaves a redirect to it here, so run `wrangler deploy` and `wrangler preview` from apps/web
// (Workers Builds does, with the project's root directory set to apps/web).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biscuits",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-11-01",
  // The server bundle uses AsyncLocalStorage from node:async_hooks.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Lets `wrangler preview` publish non-production branches as preview Workers, each reachable at
  // https://<branch-derived-name>-biscuits.<account>.workers.dev once the production Worker has been
  // deployed with preview_urls on (it is a Worker-level setting, so a preview deploy alone can't turn it on).
  "previews": {},
  "preview_urls": true
}
